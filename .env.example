# Copy this file to .env.local if you want API keys on the server.
# It is optional: every user can paste their own OpenAI API key in the app's
# "Settings" section (it is stored in that browser's localStorage).

# Server-side OpenAI key (DALL-E 3). Used when the user has not pasted their own.
OPENAI_API_KEY=

# Vector alternative: if there is no OpenAI key, Recraft v3 (SVG) is used.
RECRAFT_API_KEY=
