# Copia este archivo a .env.local si quieres claves en el servidor.
# No es obligatorio: cada usuario puede pegar su OpenAI API Key en la sección
# "Configuración" de la app (se guarda en el localStorage de su navegador).

# Key de OpenAI del servidor (DALL·E 3). Se usa si el usuario no ha pegado la suya.
OPENAI_API_KEY=

# Alternativa vectorial: si no hay ninguna key de OpenAI se usa Recraft v3 (SVG).
RECRAFT_API_KEY=
